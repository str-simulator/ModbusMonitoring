<Window x:Class="KSOEModBus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KSOE Modbus Bridge"
        Icon="pack://application:,,,/Assets/modbus.ico"
        Width="1600"
        Height="900"
        MinWidth="1200"
        MinHeight="720"
        Background="#F3F1EB">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18"
                CornerRadius="18"
                Background="#17313E">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontFamily="Consolas"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#F7F3E8"
                               Text="Connection Setting" />
                    <StackPanel Margin="0,16,0,0"
                                Orientation="Horizontal">
                        <StackPanel Width="180">
                            <TextBlock Foreground="#D8E2E7"
                                       Text="Modbus TCP Port" />
                            <TextBox Margin="0,6,0,0"
                                     Padding="10,6"
                                     FontSize="16"
                                     Text="{Binding ModbusPort, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="20,0,0,0">
                            <TextBlock Foreground="#D8E2E7"
                                       Text="Status" />
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FFF0BD"
                                       Text="{Binding StatusText}" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#D8E2E7"
                                       Text="{Binding ExcelStatusText}" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#D8E2E7"
                                       Text="{Binding ClientStatusText}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center">
                    <Button Width="140"
                            Height="40"
                            Margin="0,0,0,10"
                            Background="#2E6F95"
                            BorderBrush="#235776"
                            Command="{Binding KsoeReadTestCommand}"
                            Content="KSOE Read Test" />
                    <Button Width="140"
                            Height="40"
                            Margin="0,0,0,10"
                            Background="#6C7F45"
                            BorderBrush="#566638"
                            Command="{Binding ReloadExcelCommand}"
                            Content="Reload Excel" />
                    <Button Width="140"
                            Height="40"
                            Background="#205A4A"
                            BorderBrush="#164537"
                            Command="{Binding StartCommand}"
                            Content="Start Server" />
                </StackPanel>

                <Button Grid.Column="2"
                        Width="140"
                        Height="40"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Background="#9C3D2B"
                        BorderBrush="#7C2F21"
                        Command="{Binding StopCommand}"
                        Content="Stop Server" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,18,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="14"
                    CornerRadius="18"
                    Background="#F9F7F2"
                    BorderBrush="#D4CDBE"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="22"
                               FontWeight="Bold"
                               Foreground="#205A4A"
                               Text="STR to KSOE" />
                    <DataGrid Grid.Row="1"
                              Margin="0,14,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding StrToKsoeItems}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="60" Binding="{Binding Address}" Header="Address" />
                            <DataGridTextColumn Width="220" Binding="{Binding SignalKey}" Header="SignalKey" />
                            <DataGridTextColumn Width="220" Binding="{Binding Equip}" Header="Equip" />
                            <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="Description" />
                            <DataGridTextColumn Width="60" Binding="{Binding DisplayValue}" Header="Value" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="14"
                    CornerRadius="18"
                    Background="#F9F7F2"
                    BorderBrush="#D4CDBE"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="22"
                               FontWeight="Bold"
                               Foreground="#8B2E1D"
                               Text="KSOE to STR" />
                    <DataGrid Grid.Row="1"
                              Margin="0,14,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding KsoeToStrItems}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="60" Binding="{Binding Address}" Header="Address" />
                            <DataGridTextColumn Width="220" Binding="{Binding SignalKey}" Header="SignalKey" />
                            <DataGridTextColumn Width="220" Binding="{Binding Equip}" Header="Equip" />
                            <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="Description" />
                            <DataGridTextColumn Width="60" Binding="{Binding DisplayValue}" Header="Value" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="14"
                CornerRadius="18"
                Background="#10181D">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="20"
                           FontWeight="Bold"
                           Foreground="#E9EFE4"
                           Text="Communication Log" />
                <Grid Grid.Row="1"
                      Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Width="120"
                            Height="38"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,10"
                            Background="#435866"
                            BorderBrush="#34434D"
                            Command="{Binding ClearLogCommand}"
                            Content="Log Clear" />
                    <ListBox x:Name="LogListBox"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#D8E6D8"
                             FontFamily="Consolas"
                             ItemsSource="{Binding Logs}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
